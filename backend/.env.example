PORT=4000
NODE_ENV=development

POSTGRES_PASSWORD=clinic_pass
POSTGRES_DB=clinic_db
POSTGRES_USER=clinic_user
DATABASE_URL=postgresql://clinic_user:clinic_pass@localhost:5432/clinic_db

# Exactly 32 characters. The legacy misspelled key remains supported for backward compatibility.
ENCRYPTION_SECRET_KEY=12345678901234567890123456789012

# Comma-separated origins used by HTTP CORS. WebSocket CORS uses the same value when provided.
CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
CLINIC_CALENDAR_ID=

SMTP_FROM=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=465
SMTP_HOST=
